{
  "name": "miakapp-webapp",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "bun run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test:web": "vitest run --config vitest.config.ts",
    "check:web": "bun run lint && bun run typecheck && bun run test:web && bun run build",
    "test:protocol": "./protocol/check.sh",
    "test:runtime": "./component-runtime/check.sh",
    "test:synthetic-home": "./synthetic-home/check.sh",
    "test:coordinator-contract": "./coordinator-contract/check.sh",
    "test:control-plane-contract": "./control-plane-contract/check.sh",
    "test:control-plane-emulator": "./control-plane/check.sh",
    "test:staging-manifest": "./infrastructure/staging/check.sh"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
