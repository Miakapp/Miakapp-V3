rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /homes/{homeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /components/{homeId} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if false;
    }

    match /controlHomes/{homeId} {
      allow read, write: if false;

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /controlOwners/{ownerId} {
      allow read, write: if false;
    }

    match /controlPushOwners/{ownerId} {
      allow read, write: if false;
    }

    match /users/{ownerId}/pushChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /users/{ownerId}/pushDestinations/{destinationId} {
      allow read, write: if false;
    }

    match /homeKeyIndex/{keyId} {
      allow read, write: if false;
    }

    match /pushGrantIndex/{grantId} {
      allow read, write: if false;
    }

    match /componentUploadIndex/{uploadId} {
      allow read, write: if false;
    }

    match /componentArtifacts/{artifact} {
      allow read, write: if false;
    }

    match /componentQuarantine/{digest} {
      allow read, write: if false;
    }

    match /emulatorPushDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /controlAudit/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
