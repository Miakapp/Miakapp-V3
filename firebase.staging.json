{
  "hosting": {
    "site": "miakapp-v4-staging",
    "public": "dist",
    "trailingSlash": false,
    "cleanUrls": true,
    "ignore": [
      "firebase.staging.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/fr",
        "destination": "/fr/index.html"
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Content-Security-Policy", "value": "frame-src https://miakapp-v4-sandbox.web.app/app.html https://miakapp-v4-staging.firebaseapp.com/__/auth/iframe https://www.miakapp.com/__/auth/iframe https://miakapp.com/__/auth/iframe https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://www.recaptcha.net/recaptcha/" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
