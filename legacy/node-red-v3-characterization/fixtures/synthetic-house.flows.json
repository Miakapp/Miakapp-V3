    "name": "Living-room temperature",
    "topic": "home/living-room/temperature",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker-local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 180,
    "wires": [["commit-state"]]
  },
  {
    "id": "commit-state",
    "type": "commitVariables",
    "z": "tab-home",
    "name": "Publish state",
    "values": {
      "sensors.living_room.temperature": {
        "type": "jsonata",
        "value": "msg.payload"
      },
      "sensors.guest room.humidity_μ": {
        "type": "str",
        "value": "48"
      },
      "system.version": {
        "type": "env",
        "value": "HOUSE_VERSION"
      }
    },
    "x": 420,
    "y": 180,
    "wires": []
  },
