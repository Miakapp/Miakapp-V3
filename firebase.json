{
  "hosting": {
    "site": "miakapp-3",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "package-lock.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(.*)$",
        "destination": "https://www.miakapp.com/:1",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
