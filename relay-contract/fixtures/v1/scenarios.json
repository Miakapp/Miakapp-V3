{
  "schema": "miakapp.relay-conformance/1",
  "protocol": [
    1,
    0
  ],
  "subprotocol": "miakapp",
  "scenarios": [
    {
      "name": "handshake/coordinator receives welcome then presence",
      "requires": "RFC 0001 §6, §7.6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome",
          "match": {
            "0": 1,
            "1": 0,
            "4": true
          }
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        }
      ]
    },
    {
      "name": "handshake/user without a coordinator is unenrolled",
      "requires": "RFC 0001 §6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome",
          "match": {
            "4": false
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "FunctionDict"
        }
      ]
    },
    {
      "name": "handshake/an unknown credential is refused",
      "requires": "RFC 0001 §6, §11",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.not-a-token",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "user"
        }
      ]
    },
    {
      "name": "handshake/a version range with no overlap is refused",
      "requires": "RFC 0001 §6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            7,
            9,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "user"
        }
      ]
    },
    {
      "name": "session/a frame before hello is refused",
      "requires": "RFC 0001 §6, §14 item 6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateSync",
          "payload": [
            1,
            [
              [
                "home.temperature",
                20
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "coordinator"
        }
      ]
    },
    {
      "name": "session/a user may not send a coordinator frame",
      "requires": "RFC 0001 §7, §11, §14 item 6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "FunctionDict"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "StateSync",
          "payload": [
            1,
            [
              [
                "home.temperature",
                20
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Error",
          "match": {
            "1": 16,
            "2": 1203,
            "3": false
          }
        }
      ]
    },
    {
      "name": "session/a second hello on one connection is refused",
      "requires": "RFC 0001 §6, §14 item 6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "coordinator"
        }
      ]
    },
    {
      "name": "declaration/five slices activate and enrol the user",
      "requires": "RFC 0001 §7.5",
      "prelude": "enrolled-user",
      "steps": []
    },
    {
      "name": "declaration/slices out of order are refused",
      "requires": "RFC 0001 §7.5",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "EventSync",
          "payload": [
            1,
            [
              [
                "home.alert",
                3
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Error",
          "match": {
            "1": 32,
            "2": 1002,
            "3": false
          }
        }
      ]
    },
    {
      "name": "state/a coordinator set reaches the granted user as a patch",
      "requires": "RFC 0001 §7.2, §8.1",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateSet",
          "payload": [
            6,
            {
              "$": "epoch"
            },
            [
              [
                {
                  "$": "pathId"
                },
                0,
                21
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "StateSetOk",
          "match": {
            "0": 6
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StatePatch"
        }
      ]
    },
    {
      "name": "state/an ungranted user sees no state entry",
      "requires": "RFC 0001 §8.1",
      "prelude": "declared-home",
      "steps": [
        {
          "action": "connect",
          "peer": "other"
        },
        {
          "action": "send",
          "peer": "other",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.b",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "other",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
          "peer": "other",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "other",
          "opcode": "StateSnapshot",
          "match": {
            "2": []
          }
        },
        {
          "action": "expect",
          "peer": "other",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "other",
          "opcode": "FunctionDict"
        }
      ]
    },
    {
      "name": "call/a granted call round-trips and carries a non-spoofable principal",
      "requires": "RFC 0001 §5.4, §7.4, §8.3",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Call",
          "payload": [
            11,
            0,
            null,
            {
              "$": "functionId"
            },
            5000,
            null,
            1,
            {
              "temperature": 22
            }
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "CallDispatch",
          "match": {
            "1.0": 1,
            "1.1": "user-a",
            "1.3": null,
            "1.4": "user-a@example.test"
          },
          "capture": {
            "calleeId": "0"
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "CallAccepted"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "CallResult",
          "payload": [
            {
              "$": "calleeId"
            },
            true,
            {
              "accepted": true
            }
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "CallResult",
          "match": {
            "0": 11
          }
        }
      ]
    },
    {
      "name": "call/a call naming an unknown function is refused",
      "requires": "RFC 0001 §7.4, §11",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Call",
          "payload": [
            12,
            0,
            null,
            99999,
            5000,
            null,
            1,
            {}
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Error",
          "match": {
            "0": 12
          }
        },
        {
          "action": "expectSilence",
          "peer": "coordinator",
          "ms": 150
        }
      ]
    },
    {
      "name": "event/a subscribed user receives a coordinator event with its source",
      "requires": "RFC 0001 §5.4, §7.3, §8.2",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Subscribe",
          "payload": [
            41,
            [
              {
                "$": "topicId"
              }
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "SubscribeOk",
          "match": {
            "0": 41
          }
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Event",
          "payload": [
            42,
            {
              "$": "topicId"
            },
            0,
            null,
            {
              "active": true
            }
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Event",
          "match": {
            "4.0": 2,
            "4.3": "primary"
          }
        }
      ]
    },
    {
      "name": "event/a user event reaches the coordinator with its verified identity",
      "requires": "RFC 0001 §5.4, §7.3",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Subscribe",
          "payload": [
            41,
            [
              {
                "$": "topicId"
              }
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "SubscribeOk"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Event",
          "payload": [
            43,
            {
              "$": "topicId"
            },
            0,
            null,
            {
              "acknowledge": true
            }
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Event",
          "match": {
            "4.1": "user-a",
            "4.4": "user-a@example.test"
          }
        }
      ]
    },
    {
      "name": "event/an unsubscribed user receives nothing",
      "requires": "RFC 0001 §7.3, §8.2",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Event",
          "payload": [
            42,
            {
              "$": "topicId"
            },
            0,
            null,
            {
              "active": true
            }
          ]
        },
        {
          "action": "expectSilence",
          "peer": "user",
          "ms": 200
        }
      ]
    },
    {
      "name": "session/reauthentication renews the lease and state resynchronizes",
      "requires": "RFC 0001 §7.1, §7.2",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Reauth",
          "payload": [
            12,
            "conformance.user.a.renewed"
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "ReauthOk",
          "match": {
            "0": 12
          }
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "StateResync",
          "payload": [
            13
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        }
      ]
    },
    {
      "name": "session/reauthentication may not change the home",
      "requires": "RFC 0001 §7.1",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Reauth",
          "payload": [
            14,
            "conformance.user.a.other"
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "user"
        }
      ]
    },
    {
      "name": "presence/a coordinator disconnect is announced to the home",
      "requires": "RFC 0001 §7.6, §9",
      "profile": "fast-grace",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "close",
          "peer": "coordinator"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "HomeStatus"
        }
      ]
    }
  ],
