{
  "schema": "miakapp.relay-conformance/1",
  "protocol": [
    1,
    0
  ],
  "subprotocol": "miakapp",
  "scenarios": [
    {
      "name": "handshake/coordinator receives welcome then presence",
      "requires": "RFC 0001 §6, §7.6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome",
          "match": {
            "0": 1,
            "1": 0,
            "4": true
          }
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        }
      ]
    },
    {
      "name": "handshake/user without a coordinator is unenrolled",
      "requires": "RFC 0001 §6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome",
          "match": {
            "4": false
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "FunctionDict"
        }
      ]
    },
    {
      "name": "handshake/an unknown credential is refused",
      "requires": "RFC 0001 §6, §11",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.not-a-token",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "user"
        }
      ]
    },
    {
      "name": "handshake/a version range with no overlap is refused",
      "requires": "RFC 0001 §6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            7,
            9,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "user"
        }
      ]
    },
    {
      "name": "session/a frame before hello is refused",
      "requires": "RFC 0001 §6, §14 item 6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateSync",
          "payload": [
            1,
            [
              [
                "home.temperature",
                20
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Fatal"
        },
        {
          "action": "expectClosed",
          "peer": "coordinator"
        }
      ]
    },
    {
      "name": "session/a user may not send a coordinator frame",
      "requires": "RFC 0001 §7, §11, §14 item 6",
      "steps": [
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
