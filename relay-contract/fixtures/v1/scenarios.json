  "scenarios": [
    {
      "name": "handshake/coordinator receives welcome then presence",
      "requires": "RFC 0001 \u00a76, \u00a77.6",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome",
          "match": {
            "0": 1,
            "1": 0,
            "4": true
          }
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        }
      ]
    },
    {
