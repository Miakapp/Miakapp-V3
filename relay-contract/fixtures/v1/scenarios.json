        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "FunctionSyncOk"
        },
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome",
          "match": {
            "4": true
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "FunctionDict"
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceChange"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateSet",
          "payload": [
            6,
            {
              "$": "epoch"
            },
            [
              [
                {
                  "$": "pathId"
                },
                0,
                21
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "StateSetOk",
          "match": {
            "0": 6
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StatePatch"
        }
