        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "EventSyncOk"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "EventAclSync",
          "payload": [
            4,
            [
              [
                "user-a",
                [
                  "home.alert"
                ],
                [
                  "home.alert"
                ]
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "EventAclOk"
        },
        {
          "action": "send",
          "peer": "coordinator",
