    {
      "name": "declaration/five slices activate and enrol the user",
      "requires": "RFC 0001 §7.5",
      "steps": [
        {
          "action": "connect",
          "peer": "coordinator"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            2,
            "conformance.coordinator.primary",
            [
              "primary"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "Welcome"
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceSnapshot"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateSync",
          "payload": [
            1,
            [
              [
                "home.temperature",
                20
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "StateSyncOk",
          "match": {
            "0": 1
          }
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "StateAclSync",
          "payload": [
            2,
            [
              [
                "user-a",
                [
                  "home.*"
                ]
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "StateAclOk",
          "match": {
            "0": 2
          }
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "EventSync",
          "payload": [
            3,
            [
              [
                "home.alert",
                3
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "EventSyncOk",
          "match": {
            "0": 3
          }
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "EventAclSync",
          "payload": [
            4,
            [
              [
                "user-a",
                [
                  "home.alert"
                ],
                [
                  "home.alert"
                ]
              ]
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "EventAclOk",
          "match": {
            "0": 4
          }
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "FunctionSync",
          "payload": [
            5,
            [
              "home.set"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "FunctionSyncOk",
          "match": {
            "0": 5
          }
        },
        {
          "action": "connect",
          "peer": "user"
        },
        {
          "action": "send",
          "peer": "user",
          "opcode": "Hello",
          "payload": [
            1,
            0,
            0,
            1,
            "conformance.user.a",
            [
              "conformance-home"
            ]
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "Welcome",
          "match": {
            "4": true
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "StateSnapshot"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "TopicDict"
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "FunctionDict"
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "PresenceChange"
        }
      ]
    },
