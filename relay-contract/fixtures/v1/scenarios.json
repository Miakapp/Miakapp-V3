    {
      "name": "call/a granted call round-trips and carries a non-spoofable principal",
      "requires": "RFC 0001 \u00a75.4, \u00a77.4, \u00a78.3",
      "prelude": "enrolled-user",
      "steps": [
        {
          "action": "send",
          "peer": "user",
          "opcode": "Call",
          "payload": [
            11,
            0,
            null,
            {
              "$": "functionId"
            },
            5000,
            null,
            1,
            {
              "temperature": 22
            }
          ]
        },
        {
          "action": "expect",
          "peer": "coordinator",
          "opcode": "CallDispatch",
          "match": {
            "1.0": 1,
            "1.1": "user-a",
            "1.3": null,
            "1.4": "user-a@example.test"
          },
          "capture": {
            "calleeId": "0"
          }
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "CallAccepted"
        },
        {
          "action": "send",
          "peer": "coordinator",
          "opcode": "CallResult",
          "payload": [
            {
              "$": "calleeId"
            },
            true,
            {
              "accepted": true
            }
          ]
        },
        {
          "action": "expect",
          "peer": "user",
          "opcode": "CallResult",
          "match": {
            "0": 11
          }
        }
      ]
    },
